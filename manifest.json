{
  "id": "./",
  "name": "Tracker",
  "short_name": "Tracker",
  "description": "Offline number and category tracker",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f6f7f4",
